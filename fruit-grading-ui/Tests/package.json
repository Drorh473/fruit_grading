{
  "name": "fruit-grading-frontend-tests",
  "version": "1.0.0",
  "description": "Comprehensive test suite for Fruit Grading System frontend",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --testNamePattern='unit'",
    "test:integration": "vitest run --testNamePattern='integration'",
    "test:components": "vitest run frontend-tests/pages frontend-tests/components",
    "test:api": "vitest run frontend-tests/utils/api.test.js",
    "test:auth": "vitest run frontend-tests/context/AuthContext.test.jsx",
    "test:ci": "vitest run --coverage --reporter=json --reporter=html",
    "test:debug": "vitest --inspect-brk --inspect --no-coverage",
    "coverage:report": "vitest run --coverage && open coverage/index.html",
    "lint:tests": "eslint frontend-tests --ext .js,.jsx"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^1.0.4",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-testing-library": "^6.2.0",
    "jsdom": "^23.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "vitest": "^1.0.4",
    "@vitest/coverage-v8": "^1.0.4"
  },
  "dependencies": {
    "react-icons": "^4.12.0"
  }
}
